# --- Database (Neon on Vercel: use the pooled URL for the app, unpooled for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Auth
# Signs session tokens. Any long random string: openssl rand -hex 32
SESSION_SECRET=
# Enables the "sign in as" demo users. Leave unset outside a demo.
DEMO_LOGIN=true

# --- Scheduling (Upstash QStash). Without these, transitions run only via the sweep.
PUBLIC_API_URL=https://podium.vitaliipopov.dev
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Vercel cron sends this as a Bearer token to /api/internal/sweep.
CRON_SECRET=
